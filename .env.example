# CodeXray environment overrides.
# Copy to .env . Any value here overrides config/config.yaml (via ${VAR} expansion
# or the CODEXRAY_* keys read by backend/app/config/settings.py).

# Path to the YAML config file.
CODEXRAY_CONFIG=config/config.yaml

# --- Storage ---
CODEXRAY_INDEX_DB=data/indexes/codexray.db

# --- LLM (used from Sprint 3 onward) ---
CODEXRAY_LLM_PROVIDER=ollama
CODEXRAY_LLM_MODEL=qwen2.5-coder:7b
CODEXRAY_LLM_HOST=http://localhost:11434

# --- Embeddings (used from Sprint 4 onward) ---
CODEXRAY_EMBEDDING_MODEL=nomic-embed-text

# --- Security ---
CODEXRAY_LOCAL_ONLY=true
CODEXRAY_REDACT_SECRETS=true
